{
    "name": "spiritinlife/php-mapreduce",
    "description": "A high-performance, framework-agnostic MapReduce implementation for PHP using Amp Parallel",
    "keywords": ["mapreduce", "parallel", "big-data", "processing", "amp"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "George Chailazopoulos",
            "email": "george.chailazopoulos@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "amphp/parallel": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Spiritinlife\\MapReduce\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiritinlife\\MapReduce\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "analyse": "phpstan analyse",
        "cs-check": "phpcs src tests --standard=PSR12",
        "cs-fix": "phpcbf src tests --standard=PSR12"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
